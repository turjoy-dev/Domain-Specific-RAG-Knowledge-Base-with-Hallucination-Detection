# =====================================================================
# Git Ignore Rules: Domain-Specific RAG with Hallucination Detection
# =====================================================================

# Bytecode & Python Cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Local Vector Databases & Model Weights
# (Run python build_vector_store.py to generate Database/chroma_db)
Database/chroma_db/
Database/bm25_index.pkl
test_chroma_tmp/
*.sqlite3
*.bin
*.pkl
*.pickle
!Database/.gitkeep

# Environment Variables & Secrets
.env
.env.*
!.env.example

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Streamlit Local Cache
.streamlit/

# OS & Editor Specific Files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# Runtime Logs
*.log
